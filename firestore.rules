rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == "bjOeOH6etCYlguhidyLTDQImrJt1";
    }

    match /members/{document=**} { allow read, write: if isOwner(); }
    match /transactions/{document=**} { allow read, write: if isOwner(); }
    match /appSettings/{document=**} { allow read, write: if isOwner(); }
    match /{document=**} { allow read, write: if false; }
  }
}

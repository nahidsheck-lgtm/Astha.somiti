rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // appSettings document ID is the authenticated Google user's Firebase UID.
    match /appSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // The application does not directly expose other collections in this build.
    // Append-only manual backups; each signed-in user can access only their own backups.
    match /appBackups/{userId}/snapshots/{backupId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false;
    }
    match /members/{document=**} { allow read, write: if false; }
    match /transactions/{document=**} { allow read, write: if false; }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /appSettings/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // Public ledger links can read one known document only; listing is disabled.
    match /publicCustomerLedgers/{ledgerId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // appSettings document ID is the authenticated Google user's Firebase UID.
    match /appSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // The application does not directly expose other collections in this build.
    match /members/{document=**} { allow read, write: if false; }
    match /transactions/{document=**} { allow read, write: if false; }
  }
}

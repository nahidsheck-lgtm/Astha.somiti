rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Each authenticated Gmail account can access only its own private workspace.
    match /appSettings/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // No shared approval queue or cross-account data access is used by this app.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
